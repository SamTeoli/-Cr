  localizations:
  - locale: 0
    rulesText: "\uCE74\uB4DC 2\uC7A5\uC744 \uB4DC\uB85C\uC6B0\uD55C \uB4A4 \uD328\uC5D0\uC11C
      \uB2E4\uB978 \uCE74\uB4DC 1\uC7A5\uC744 \uC18C\uBA78\uC2DC\uD0A8\uB2E4."
    detailedRulesText: "\uCE74\uB4DC\uB294 \uD55C \uC7A5\uC529 \uB4DC\uB85C\uC6B0\uD569\uB2C8\uB2E4.
      \uD328\uAC00 10\uC7A5\uC774\uBA74 \uD574\uB2F9 \uB4DC\uB85C\uC6B0\uB9CC \uC2E4\uD328\uD558\uACE0
      \uCE74\uB4DC\uB294 \uB371 \uB9E8 \uC704\uC5D0 \uB0A8\uC2B5\uB2C8\uB2E4. \uC774
      \uCE74\uB4DC \uC790\uC2E0\uC740 \uC18C\uBA78 \uB300\uC0C1\uC73C\uB85C \uC120\uD0DD\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    levels:
    - level: 1
      rulesText: "\uCE74\uB4DC 2\uC7A5 \uB4DC\uB85C\uC6B0 \uD6C4 \uB2E4\uB978 \uCE74\uB4DC
        1\uC7A5 \uC18C\uBA78"
    - level: 2
      rulesText: "\uCE74\uB4DC 3\uC7A5 \uB4DC\uB85C\uC6B0"
    - level: 3
      rulesText: "\uD6A8\uACFC \uB3D9\uC77C"
    - level: 4
      rulesText: "\uB2E4\uB978 \uCE74\uB4DC 0~1\uC7A5 \uC18C\uBA78"
    - level: 5
      rulesText: "\uBE44\uC6A9 2 \uC774\uC0C1 \uCE74\uB4DC \uC18C\uBA78 \uC2DC \uC544\uAD70
        \uBAAC\uC2A4\uD130 \uBC29\uC5B4 2"
