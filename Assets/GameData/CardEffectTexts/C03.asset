  localizations:
  - locale: 0
    rulesText: "\uD50C\uB808\uC774\uC5B4 \uD134 \uC885\uB8CC \uC2DC \uC774\uBC88
      \uD134 \uACF5\uACA9\uD558\uC9C0 \uC54A\uC558\uB2E4\uBA74 \uBC29\uC5B4 3\uC744
      \uC5BB\uB294\uB2E4."
    detailedRulesText: "\uACF5\uACA9 \uC120\uC5B8\uC774 \uC544\uB2C8\uB77C \uBAA8\uB4E0
      \uD0C0\uACA9\uACFC \uC0AC\uD6C4 \uAC80\uC0AC\uAC00 \uB05D\uB09C \uACF5\uACA9
      \uC644\uB8CC \uAE30\uB85D\uC744 \uD655\uC778\uD569\uB2C8\uB2E4. \uACF5\uACA9\uC774
      \uBB34\uD6A8\uD654\uB418\uAC70\uB098 \uB300\uC0C1 \uC0C1\uC2E4\uB85C \uC644\uB8CC\uB418\uC9C0
      \uC54A\uC558\uB2E4\uBA74 \uACF5\uACA9\uD558\uC9C0 \uC54A\uC740 \uAC83\uC73C\uB85C
      \uCC98\uB9AC\uD569\uB2C8\uB2E4."
    levels:
    - level: 1
      rulesText: "\uD50C\uB808\uC774\uC5B4 \uD134 \uC885\uB8CC \uC2DC \uACF5\uACA9\uD558\uC9C0
        \uC54A\uC558\uB2E4\uBA74 \uBC29\uC5B4 3\uC744 \uC5BB\uC2B5\uB2C8\uB2E4."
    - level: 2
