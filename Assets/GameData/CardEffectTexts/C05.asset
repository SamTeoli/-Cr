  localizations:
  - locale: 0
    rulesText: "\uC801 1\uAC1C\uB97C \uC624\uB978\uCABD\uC73C\uB85C 1\uCE78 \uC774\uB3D9\uC2DC\uD0A8
      \uB4A4 \uC57D\uD654 1\uC744 \uBD80\uC5EC\uD55C\uB2E4."
    detailedRulesText: "\uB300\uC0C1\uC740 \uC120\uC5B8\uD560 \uB54C \uACE0\uC815\uD569\uB2C8\uB2E4.
      \uC774\uB3D9\uC774 \uACE0\uC815 \uB54C\uBB38\uC5D0 \uC2E4\uD328\uD574\uB3C4
      \uB300\uC0C1\uC774 \uB0A8\uC544 \uC788\uC73C\uBA74 \uC57D\uD654\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4.
      \uCDE8\uC57D\uC740 \uC704\uCE58\uAC00 \uC2E4\uC81C \uBC14\uB010 \uACBD\uC6B0\uC5D0\uB9CC
      \uC801\uC6A9\uD569\uB2C8\uB2E4."
    levels:
    - level: 1
      rulesText: "\uC624\uB978\uCABD 1\uCE78 \uC774\uB3D9 \uD6C4 \uC57D\uD654 1"
    - level: 2
      rulesText: "\uC57D\uD654 2"
    - level: 3
      rulesText: "\uD6A8\uACFC \uB3D9\uC77C"
    - level: 4
      rulesText: "\uC774\uB3D9 \uC131\uACF5 \uC2DC \uCDE8\uC57D 1 \uCD94\uAC00"
    - level: 5
      rulesText: "\uC624\uB978\uCABD\uC73C\uB85C 2\uCE78 \uC774\uB3D9\uD55C \uB4A4
        \uC57D\uD654 2\uC640 \uCDE8\uC57D 1"
