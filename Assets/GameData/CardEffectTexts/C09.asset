  localizations:
  - locale: 0
    rulesText: "\uB2E4\uC74C \uC801 \uD134 \uCC98\uC74C \uACF5\uACA9\uBC1B\uB294
      \uC544\uAD70 \uBAAC\uC2A4\uD130\uB294 \uD53C\uD574\uB97C \uBC1B\uAE30 \uC804\uC5D0
      \uBC29\uC5B4 3\uC744 \uC5BB\uB294\uB2E4."
    detailedRulesText: "\uACF5\uACA9 \uB300\uC0C1\uC774 \uC544\uAD70 \uBAAC\uC2A4\uD130\uC778
      \uCCAB \uC720\uD6A8 \uACF5\uACA9\uC5D0\uC11C \uD53C\uD574 \uC801\uC6A9 \uC804\uC5D0
      \uBC29\uC5B4\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4. \uC5F0\uC18D\uACF5\uACA9\uC5D0\uC11C\uB294
      \uCCAB \uD0C0\uACA9 \uC804\uC5D0\uB9CC \uBC1C\uB3D9\uD569\uB2C8\uB2E4."
    levels:
    - level: 1
      rulesText: "\uCCAB \uACF5\uACA9 \uC804 \uBC29\uC5B4 3"
    - level: 2
      rulesText: "\uBC29\uC5B4 4"
    - level: 3
      rulesText: "\uD6A8\uACFC \uB3D9\uC77C"
    - level: 4
      rulesText: "\uB0A8\uC740 \uBC29\uC5B4\uAC00 \uB2E4\uC74C \uD50C\uB808\uC774\uC5B4
        \uD134 \uC885\uB8CC\uAE4C\uC9C0 \uC720\uC9C0"
    - level: 5
      rulesText: "\uBC29\uC5B4 5"
