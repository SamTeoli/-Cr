  catalogCardId: C01
  localizations:
  - locale: 0
    rulesText: "\uC18C\uD658\uB420 \uB54C \uC801 1\uAC1C\uB97C \uC67C\uCABD\uC73C\uB85C
      1\uCE78 \uC774\uB3D9\uC2DC\uD0A8\uB2E4. \uACE0\uC815 \uB54C\uBB38\uC5D0 \uC2E4\uD328\uD558\uBA74
      \uC774 \uBAAC\uC2A4\uD130\uB294 \uBC29\uC5B4 2\uB97C \uC5BB\uB294\uB2E4."
    detailedRulesText: "\uB300\uC0C1\uC740 \uC120\uC5B8\uD560 \uB54C \uACE0\uC815\uD569\uB2C8\uB2E4.
      \uC774\uB3D9\uC740 \uD55C \uCE78\uC529 \uCC98\uB9AC\uD558\uBA70 \uB2E4\uB978
      \uC801\uC744 \uBC00\uACE0 \uB05D \uC704\uCE58\uC5D0\uC11C\uB294 \uC6D0\uD615
      \uD68C\uC804\uD569\uB2C8\uB2E4. \uACE0\uC815 \uC801\uC774 \uACBD\uB85C\uB97C
      \uB9C9\uC544 \uC774\uB3D9\uC774 \uC2E4\uD328\uD55C \uACBD\uC6B0\uC5D0\uB9CC
      \uBC29\uC5B4\uB97C \uC5BB\uC2B5\uB2C8\uB2E4."
    levels:
    - level: 1
      rulesText: "\uC18C\uD658\uB420 \uB54C \uC801 1\uAC1C\uB97C \uC67C\uCABD\uC73C\uB85C
        1\uCE78 \uC774\uB3D9\uC2DC\uD0B5\uB2C8\uB2E4. \uACE0\uC815 \uB54C\uBB38\uC5D0
        \uC2E4\uD328\uD558\uBA74 \uBC29\uC5B4 2\uB97C \uC5BB\uC2B5\uB2C8\uB2E4."
    - level: 2
      rulesText: "\uD6A8\uACFC \uB3D9\uC77C"
    - level: 3
      rulesText: "\uD6A8\uACFC \uB3D9\uC77C"
    - level: 4
      rulesText: "\uACE0\uC815 \uB54C\uBB38\uC5D0 \uC774\uB3D9\uC774 \uC2E4\uD328\uD558\uBA74
        \uBC29\uC5B4 3\uC744 \uC5BB\uC2B5\uB2C8\uB2E4."
    - level: 5
      rulesText: "\uC774\uB3D9 \uC131\uACF5 \uC2DC\uC5D0\uB3C4 \uC774 \uBAAC\uC2A4\uD130\uAC00
        \uBC29\uC5B4 1\uC744 \uC5BB\uC2B5\uB2C8\uB2E4."
