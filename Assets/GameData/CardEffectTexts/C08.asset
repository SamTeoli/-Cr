  - locale: 0
    rulesText: "\uB2E4\uC74C \uC801 \uD134 \uCC98\uC74C \uC774\uB3D9\uD558\uB294
      \uC801\uC758 \uC774\uB3D9\uC744 0\uCE78\uC73C\uB85C \uB300\uCCB4\uD558\uACE0
      \uC18D\uBC15 1\uC744 \uBD80\uC5EC\uD55C\uB2E4."
    detailedRulesText: "\uC124\uCE58\uD55C \uD134\uC5D0\uB294 \uBC1C\uB3D9\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. \uC6D0\uB798 \uC774\uB3D9 \uCE78 \uC218\uAC00 0\uC774\uAC70\uB098
      \uACE0\uC815\uC73C\uB85C \uC774\uB3D9 \uBA85\uB839 \uC790\uCCB4\uAC00 \uC131\uB9BD\uD558\uC9C0
      \uC54A\uB294 \uD589\uB3D9\uC740 \uC720\uD6A8 \uC0AC\uAC74\uC774 \uC544\uB2C8\uBBC0\uB85C
      \uBC1C\uB3D9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    levels:
    - level: 1
      rulesText: "\uCCAB \uC801 \uC774\uB3D9\uC744 0\uCE78\uC73C\uB85C \uB300\uCCB4\uD558\uACE0
        \uC18D\uBC15 1"
    - level: 2
      rulesText: "\uAC19\uC740 \uC801\uC5D0\uAC8C \uC57D\uD654 1 \uCD94\uAC00"
    - level: 3
