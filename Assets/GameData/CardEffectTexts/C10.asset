  localizations:
  - locale: 0
    rulesText: "\uC544\uAD70\uC5D0\uAC8C \uC601\uD5A5\uC744 \uC8FC\uB294 \uB2E4\uC74C
      \uC801 \uB2A5\uB825 1\uAC1C\uB97C \uBB34\uD6A8\uD654\uD55C\uB2E4. \uC77C\uBC18
      \uACF5\uACA9\uC740 \uC81C\uC678\uD55C\uB2E4."
    detailedRulesText: "\uCD5C\uC885 \uB300\uC0C1\uC774\uB098 \uD6A8\uACFC \uBC94\uC704\uC5D0
      \uC544\uAD70 \uBAAC\uC2A4\uD130 \uB610\uB294 \uD50C\uB808\uC774\uC5B4\uAC00
      \uD3EC\uD568\uB418\uB294 \uC801 \uB2A5\uB825\uB9CC \uBB34\uD6A8\uD654\uD569\uB2C8\uB2E4.
      \uB2A5\uB825\uC758 \uBE44\uC6A9\xB7\uC0AC\uC6A9 \uD69F\uC218\xB7\uD589\uB3D9\uC740
      \uBC18\uD658\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    levels:
    - level: 1
      rulesText: "\uB2E4\uC74C \uC801 \uB2A5\uB825 1\uAC1C \uBB34\uD6A8 / \uC77C\uBC18
        \uACF5\uACA9 \uC81C\uC678"
    - level: 2
      rulesText: "\uD6A8\uACFC \uB3D9\uC77C"
    - level: 3
      rulesText: "\uB2A5\uB825 \uCD9C\uCC98 \uC801\uC5D0\uAC8C \uC57D\uD654 1"
    - level: 4
      rulesText: "\uBC94\uC704 \uB2A5\uB825\uC774 \uC544\uAD70\uC744 \uD3EC\uD568\uD558\uBA74
        \uBC1C\uB3D9 \uAC00\uB2A5"
    - level: 5
      rulesText: "\uC804\uD22C\uB2F9 1\uD68C \uBC1C\uB3D9 \uD6C4 \uD328\uB85C \uD68C\uC218"
