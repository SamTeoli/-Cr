  localizations:
  - locale: 0
    rulesText: "\uD50C\uB808\uC774\uC5B4 \uD134 \uC2DC\uC791 \uC2DC \uD328\uAC00
      4\uC7A5 \uC774\uD558\uB77C\uBA74 \uCE74\uB4DC 1\uC7A5\uC744 \uB4DC\uB85C\uC6B0\uD55C\uB2E4."
    detailedRulesText: "\uC870\uAC74\uC740 \uD50C\uB808\uC774\uC5B4 \uD134 \uC2DC\uC791
      \uD6A8\uACFC\uB97C \uCC98\uB9AC\uD558\uAE30 \uC9C1\uC804\uC5D0 \uD55C \uBC88
      \uD655\uC778\uD569\uB2C8\uB2E4. \uB4DC\uB85C\uC6B0 \uB3C4\uC911 \uD328\uAC00
      \uB298\uC5B4\uB3C4 \uC774\uBBF8 \uC815\uD574\uC9C4 \uB0A8\uC740 \uB4DC\uB85C\uC6B0\uB294
      \uACC4\uC18D \uCC98\uB9AC\uD569\uB2C8\uB2E4."
    levels:
    - level: 1
      rulesText: "\uD328 4\uC7A5 \uC774\uD558\uB77C\uBA74 \uB4DC\uB85C\uC6B0 1"
    - level: 2
      rulesText: "\uD328\uAC00 5\uC7A5 \uC774\uD558\uB77C\uBA74 \uBC1C\uB3D9"
    - level: 3
      rulesText: "\uD6A8\uACFC \uB3D9\uC77C"
    - level: 4
      rulesText: "\uB4DC\uB85C\uC6B0 \uC131\uACF5 \uD6C4 \uC0DD\uBA85\uB825\uC774
        \uAC00\uC7A5 \uB0AE\uC740 \uC544\uAD70 \uBAAC\uC2A4\uD130 \uBC29\uC5B4 1"
    - level: 5
      rulesText: "\uC870\uAC74 \uCDA9\uC871 \uC2DC \uCE74\uB4DC 2\uC7A5 \uB4DC\uB85C\uC6B0"
